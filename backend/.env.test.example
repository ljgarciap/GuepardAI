# .env.test.example
# ===================
# Copia este archivo como '.env.test' en la raíz del backend.
# Este archivo es cargado EXCLUSIVAMENTE cuando se ejecutan los tests con pytest.
# NUNCA sobreescribe el .env de producción.
#
# La variable TEST_DATABASE_URL apunta al contenedor de test (puerto 5433)
# que se levanta con: docker compose -f docker-compose.test.yml up -d

# ─────────────────────────────────────────────────────────────────────────────
# Base de Datos de TEST
# Notar: puerto 5433 (test) ≠ puerto 5432 (producción)
#        base de datos 'ai_db_test' ≠ 'ai_db' (producción)
# ─────────────────────────────────────────────────────────────────────────────
TEST_DATABASE_URL=postgresql+psycopg://root:root@localhost:5433/ai_db_test

# ─────────────────────────────────────────────────────────────────────────────
# Variables de LLM (pueden ser falsas, los tests las mockean)
# Se necesitan para que los módulos importen sin error.
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-test-fake-key-for-testing
OPENAI_API_KEY=sk-test-fake-key-for-testing
MISTRAL_API_KEY=fake-mistral-key-for-testing
GOOGLE_AI_API_KEY=fake-google-key-for-testing

# ─────────────────────────────────────────────────────────────────────────────
# Auth (Autenticación / Multi-tenant) — auth/security.py exige esto seteado,
# no tiene default (ver review de seguridad, blocker #2).
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=test-only-insecure-secret-do-not-use-in-prod

# ─────────────────────────────────────────────────────────────────────────────
# Asegúrate de que DATABASE_URL NO apunte a producción durante los tests.
# conftest.py redirige todas las conexiones a TEST_DATABASE_URL.
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://root:root@localhost:5433/ai_db_test
