GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY_HERE
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
DATABASE_URL=postgresql+psycopg://root:root@db:5432/ai_db
ACTIVE_EMBEDDING_PROVIDER=mistral
ACTIVE_LLM=mistral
PORT=8000

# Auth (Autenticación / Multi-tenant) — obligatorio, sin default seguro posible.
# Generar uno propio, ej.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Superadmin inicial (utils/seed_superadmin.py) — si se omiten, el seed no
# corre y no bloquea el arranque, pero nadie podrá loguearse en producción.
SUPERADMIN_EMAIL=CHANGE_ME@example.com
SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Usuarios de prueba (utils/seed_test_users.py) — SOLO para desarrollo/QA
# local. NUNCA setear estas variables en el .env de un servidor real: crean
# una organización + un admin + un cliente de prueba con las credenciales
# que pongas acá. Si se omiten, el seed no corre (comportamiento por defecto).
TEST_TENANT_NAME=Test Organization
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_CLIENTE_EMAIL=
TEST_CLIENTE_PASSWORD=
